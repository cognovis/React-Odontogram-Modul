# Aidbox live mode for the standalone development app.
#
# Copy this file to `.env` (git-ignored) and fill it in. NEVER commit a
# filled-in copy and never paste a real secret into this example.
#
# USE A SCOPED MACHINE CLIENT, NEVER AN ADMIN ACCOUNT. This app runs in a
# browser, so whatever is put in these variables reaches the browser and is
# readable by anyone who can open the page. Limit the client with an Aidbox
# AccessPolicy to what the chart needs:
#   /fhir/Patient                                    GET only
#   /fhir/Device                                     GET only
#   /fhir/Observation, /fhir/Condition,
#   /fhir/ServiceRequest, /fhir/CarePlan             GET, PUT, POST, DELETE
# DELETE is needed because clearing a finding has to remove its resource.
#
# The secret below is for the DEVELOPMENT SERVER only: `vite build` refuses to
# run while it is set (see secretGuard.ts).

# Base URL of the Aidbox instance. The app appends the FHIR endpoint `/fhir`.
VITE_AIDBOX_BASE_URL=

# The scoped machine client's id and secret (HTTP Basic auth).
VITE_AIDBOX_CLIENT_ID=odontogram-live
VITE_AIDBOX_CLIENT_SECRET=

# The patient charted when the URL names none. `?patient=<id>` always wins.
VITE_DEFAULT_PATIENT_ID=
