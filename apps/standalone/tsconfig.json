{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@cognovis/react-odontogram": ["../../packages/odontogram/src/index.ts"],
      "@cognovis/react-odontogram-fhir": ["../../packages/odontogram-fhir/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "secretGuard.ts"]
}
